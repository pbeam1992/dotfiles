# Interactive shell setup. Homebrew itself is put on PATH by ~/.zprofile.

# Everything below is installed from the Brewfile. Each piece is guarded so the shell still
# starts cleanly before `brew bundle` has run.
brew_prefix="${HOMEBREW_PREFIX:-/opt/homebrew}"

if [[ -r "${brew_prefix}/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "${brew_prefix}/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# Must be sourced last so it sees every widget defined above.
if [[ -r "${brew_prefix}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "${brew_prefix}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

unset brew_prefix
